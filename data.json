 "news_manual": [
  {
   "date": "2026-11-07",
   "src": "Tribuna de Ávila",
   "url": "https://www.tribunaavila.com/noticias/465685/segunda-para-el-hotel-4postes-avila-autentica-el-bulevar",
   "title": "Segunda victoria del curso: 91-90 al Valle de Egüés",
   "body": "El primer equipo se impuso por la mínima en el Carlos Sastre en la sexta jornada. Salió mejor, con un 21-14 en el primer cuarto, y el último cuarto fue muy igualado, resuelto con el apoyo de la grada. Con este resultado suma su segunda victoria de la temporada.",
   "manual": true
  },
  {
   "date": "2026-10-24",
   "src": "Tribuna de Ávila",
   "url": "https://www.tribunaavila.com/noticias/463905/de-momento-el-carlos-sastre-no-es-un-fortin",
   "title": "Derrota en casa ante Los Arcos Solares (73-104)",
   "body": "El primer equipo no pudo sumar su segunda victoria como local y cayó con claridad ante el Restaurante Los Arcos Solares en la cuarta jornada, con el partido decidido ya en el primer tiempo. El siguiente compromiso es el sábado 31 de octubre, a las 19:00, en la pista del San Prudencio, en Vitoria.",
   "manual": true
  },
  {
   "date": "2026-10-11",
   "src": "Tribuna de Ávila",
   "url": "https://www.tribunaavila.com/noticias/462233/primera-para-el-hotel-cuatro-postes-avila-autentica-el-bulevar",
   "title": "Primera victoria del curso para el Hotel 4Postes Ávila Auténtica El Bulevar",
   "body": "El primer equipo se estrena en casa, en el Carlos Sastre, con un 98-87 ante el Universidad Deusto Loiola Indautxu. El tercer cuarto, ganado por 35-14 con el apoyo de la grada, decidió el partido. Fran Quirós (21 puntos) y Alberto Martín (17) fueron los máximos anotadores locales.",
   "manual": true
  },
  {
   "date": "2026-10-04",
   "src": "Tribuna de Ávila",
   "url": "https://www.tribunaavila.com/noticias/461267/primera-derrota-verderona-en-la-vuelta-al-cole",
   "title": "Derrota en el debut liguero ante De Morro Fino Cantbasket04",
   "body": "El equipo cayó 96-78 en Cantabria en la primera jornada del Grupo A-A de Tercera FEB. El partido estuvo igualado hasta el descanso y los locales se escaparon en la segunda mitad.",
   "manual": true
  },
  {
   "date": "2026-10-02",
   "src": "Tribuna de Ávila",
   "url": "https://www.tribunaavila.com/noticias/461174/el-nuevo-obila-de-alberto-jimenez-debuta-ante-el-exigente-cantbasket",
   "title": "El nuevo Óbila de Alberto Jiménez debuta ante el Cantbasket",
   "body": "El primer equipo estrena la temporada fuera de casa tras un mes de preparación con fichajes y algunas molestias físicas. La plantilla se ha renovado con varios jugadores de la cantera y el técnico pide a la afición que acompañe al equipo.",
   "manual": true
  },
  {
   "date": "2026-10-02",
   "src": "Deportes Ávila",
   "url": "https://deportesavila.es/el-obila-alza-el-telon-la-cantera-verderona-desafia-al-cantbasket-04",
   "title": "El Óbila abre la temporada 2026/27 con apuesta por la cantera",
   "body": "Alberto Jiménez debuta en el banquillo de un equipo en el que nueve de los doce jugadores inscritos se han formado en el club. Llega tras una campaña en la que se quedó cerca del ascenso a Segunda FEB.",
   "manual": true
  }
 ],
